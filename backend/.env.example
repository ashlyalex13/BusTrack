# Copia este archivo como .env y ajusta los valores.
APP_ENV=development
DATABASE_URL=mysql+pymysql://bustrack:bustrack@127.0.0.1:3307/bustrack?charset=utf8mb4

# Secretos de mínimo 32 caracteres. En producción son obligatorios y deben ser únicos.
# Genera cada uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ojo: cambiar QR_SECRET invalida los QR de los tiquetes ya emitidos.
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-32-caracteres-o-mas
QR_SECRET=reemplaza-por-otro-secreto-aleatorio-de-32-caracteres-o-mas
JWT_EXPIRE_MINUTES=480

# Zona horaria de la terminal (los servidores en la nube suelen estar en UTC).
APP_TIMEZONE=America/Bogota

SEAT_HOLD_SECONDS=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
CORS_ORIGINS=http://localhost:5173
